# Secret values only — never commit this file.
# Grammar: NAME=value, optional `export`, trailing comments on bare values,
# or single/double quotes. Quoted values may span physical lines; double quotes
# support \\, \", \n, \r, \t, \$, and \'. Values are literal: no
# interpolation or `_FILE` expansion. Malformed/duplicate lines are errors.
# A private .digest-key file is auto-created next to this file on first
# use; it keys hmac-sha256 fingerprints. Keep it gitignored and back it up
# securely with this file. If it is missing while saved HMACs exist, the CLI
# stops until the key is restored; do not replace it casually.
GITHUB_SYNC_TOKEN=
FORGEJO_TOKEN=
DEPLOY_HOST_VALUE=
DEPLOY_SSH_KEY_VALUE=
DEPLOY_TARGET_VALUE=
SONAR_TOKEN_VALUE=
SEMGREP_APP_TOKEN_VALUE=
